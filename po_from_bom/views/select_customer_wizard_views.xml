<odoo>
    <data>
        <record id="view_select_customer_wizard" model="ir.ui.view">
            <field name="name">select.customer.wizard.form</field>
            <field name="model">select.customer.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Customer">
                    <field name="bom_id"/>
                    <group>
                        <field name="customer_id" options="{'no_open': True, 'no_create': True}" required="1"/>
                    </group>
                    <footer>
                        <button string="Create" type="object" name="action_create_delivery_order" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_select_customer_wizard" model="ir.actions.act_window">
            <field name="name">Select Customer</field>
            <field name="res_model">select.customer.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_select_customer_wizard"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>