<odoo>
    <data>
        <record id="view_mrp_bom_form_inherit" model="ir.ui.view">
            <field name="name">mrp.bom.form.inherit</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        
                    <button name="action_create_purchase_orders" type="object" string="Crear Orden de Compras" class="oe_highlight"/>
                    <button invisible="1" name="action_open_customer_wizard" type="object" string="Crear Conduce de Cliente" class="oe_highlight"/>
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>