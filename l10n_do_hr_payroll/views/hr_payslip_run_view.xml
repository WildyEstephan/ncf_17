<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<!-- Inherit Form View to Modify it -->
	<record id="hr_payslip_run_form_view_inherit" model="ir.ui.view">
		<field name="name">hr.payslip.run.form.view.inherit</field>
		<field name="model">hr.payslip.run</field>
		<field name="inherit_id" ref="hr_payroll.hr_payslip_run_form" />
		<field name="arch" type="xml">
			<xpath expr="//header//button[last()]" position="after">
			<button name="generate_payroll_xlsx" type="object" string="Generar 
				archivo" class="oe_highlight"/>
				<!-- <button name="action_mail_send" type="object" class="oe_highlight" string="Enviar recibos"/> -->
                <button name="assign_worked_hours" type="object" string="Asignar horas" class="oe_highlight"/>
                <button name="compute_all_payslips" type="object" string="Calcular todos" class="oe_highlight"/>
                <button name="confirm_all_payslips" type="object" string="Confirmar todos" class="oe_highlight" style="position:relative; left:150px;"/>
			</xpath>

			<xpath expr="//field[@name='country_id']" position="after">
				<field name="is_christmas_salary" />
				<field name="payroll_xlsx_binary"  filename="payroll_xlsx_file_name" readonly="1" invisible="payroll_xlsx_binary == False"/>
				<field name="payroll_xlsx_file_name" invisible="1" />

			</xpath>

			<xpath expr="//sheet" position="inside">
                <field name="slip_ids">
                    <tree editable="bottom">
                        <field name="number" readonly="1"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="real_worked_hours" string="Horas trabajadas"/>
						 <field name="basic_wage" string="Salario Basico" sum="Total"/>
                        <field name="total_to_pay" string="Total a Pagar" sum="Total"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                        <field name="state"/>
                    </tree>
                </field>
            </xpath>
		</field>
	</record>

</odoo>